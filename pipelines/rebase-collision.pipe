{
  "version": 1,
  "name": "rebase-collision",
  "description": "Required Rebase pipeline. Produces typed { conflicts, episodes } coordination grouping output.",
  "x-rebase": {
    "contract": "collisionRunOutput",
    "intent": "Group N worktree fingerprints into coordination episodes instead of noisy pairwise alerts."
  },
  "source": "source_1",
  "components": [
    {
      "id": "source_1",
      "provider": "webhook",
      "config": {
        "key": "webhook://*",
        "mode": "Source",
        "name": "Rebase Collision Input",
        "include": [{ "path": "*" }],
        "parameters": {
          "endpoint": "/pipe/process",
          "port": 5565
        },
        "sync": false,
        "type": "webhook"
      },
      "ui": {}
    },
    {
      "id": "rebase_1",
      "provider": "rebase_coordination",
      "config": {
        "operation": "collision"
      },
      "ui": {},
      "input": [
        { "lane": "text", "from": "source_1" }
      ]
    },
    {
      "id": "response_1",
      "provider": "response",
      "config": {},
      "ui": {},
      "input": [
        { "lane": "text", "from": "rebase_1" }
      ]
    }
  ]
}
