{
  "version": "1",
  "name": "rebase-merge-risk",
  "description": "Verify active work orders and dirty diffs before Rebase declares a coordination episode merge-safe.",
  "inputs": {
    "repoRoot": "string",
    "episode": "object",
    "workOrders": "array",
    "activeDiffs": "array",
    "verificationCommands": "array"
  },
  "outputs": {
    "mergeRisk": {
      "safe": "boolean",
      "gitConflicts": "array",
      "failedChecks": "array",
      "requiredWorkOrders": "array"
    }
  },
  "nodes": [
    {
      "id": "predict-text-conflicts",
      "type": "diff.patch_signature_compare",
      "with": {
        "compareHunkAnchors": true,
        "compareTouchedRanges": true
      }
    },
    {
      "id": "simulate-private-merge",
      "type": "git.sandbox_merge",
      "with": {
        "mutateUserBranches": false,
        "applyDirtyDiffs": true
      }
    },
    {
      "id": "run-checks",
      "type": "process.run",
      "with": {
        "onlyAfterCleanMerge": true
      }
    },
    {
      "id": "emit-required-work-orders",
      "type": "policy.repair_work_order",
      "with": {
        "blockUntilClean": true
      }
    }
  ]
}
